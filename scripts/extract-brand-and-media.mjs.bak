  const feedPath = path.join(DIRS.data, "social-feed.json");
  const mediaPath = path.join(DIRS.data, "social-media.json");
  await fs.writeFile(feedPath, JSON.stringify(feed, null, 2), "utf8");
  await fs.writeFile(mediaPath, JSON.stringify(feed, null, 2), "utf8");

  console.log(`✔ Catálogo documental generado en src/data/social-feed.json (${feed.length} registros reales).`);
}

async function main() {
  console.log("=======================================================================");
  console.log(" DIGNIDAD GUATEMALA (#28 TSE) — EXTRACTOR DE MARCA, FOTOS Y REDES");
  console.log("=======================================================================");
  await ensureDirs();
  await extractOfficialLogo();
  await syncSocialVideosWithYtDlp();
  await processDocumentaryPhotos();
  await generateSocialFeedJson();
  console.log("=======================================================================");
}

main().catch((err) => {
  console.error("Error en extract-brand-and-media:", err);
  process.exit(1);
});
